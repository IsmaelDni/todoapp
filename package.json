{
  "name": "witodo",
  "version": "1.0.1",
  "main": "main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:todo-app": "node dist/todo-app/server/server.mjs",
    "electron": "electron .",
    "package": "electron-builder",
    "build:electron": "npm run build:angular && electron-builder",
    "build:angular": "ng build --base-href ./ --output-path=dist/todo-app --configuration production",
    "build:ssr": "ng run todo-app:server:production",
    "build:ssr:dev": "ng run todo-app:server:development",
    "build:ssr:prod": "ng run todo-app:server:production",
    "build:ssr:prod:electron": "ng run todo-app:server:production && electron-builder",
    "postinstall": "ngcc --properties es2022 browser module main --first-only --create-ivy-entry-points",
    "postinstall:electron": "npm run postinstall && electron-reloader .",
    "postinstall:electron:dev": "npm run postinstall && electron-reloader .",
    "postinstall:electron:prod": "npm run postinstall && electron-reloader ."
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/platform-server": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@angular/ssr": "^19.2.13",
    "@fullcalendar/angular": "^6.1.17",
    "@fullcalendar/daygrid": "^6.1.17",
    "@ng-bootstrap/ng-bootstrap": "^18.0.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.13.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "ngx-electron": "^2.2.0",
    "robotjs": "^0.6.0",
    "rxjs": "~7.8.0",
    "sqlite3": "^5.1.7",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "build": {
    "appId": "com.example.todoapp",
    "asar": true,
    "files": [
      "dist/**/*",
      "main.js",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    }
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.13",
    "@angular/cli": "^19.2.13",
    "@angular/compiler-cli": "^19.2.0",
    "@angular/localize": "^19.2.0",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "concurrently": "^9.1.2",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "electron-reloader": "^1.2.3",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.7.2"
  }
}
